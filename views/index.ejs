<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= title %></title>
		<link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon" />
		<link rel="stylesheet" href="/style.css" />
	</head>
	<body>
		<%- include("./partials/header") %>
		<!--  -->
		<div class="info">
			<p>Only members who know the secret password can see usernames and dates.</p>
			<% if (!locals.user)  {%>
				<p class="no-user">Login or create an account to get a chance to become a member!</p>
			<% }%>
		</div>
		<div class="message-container">
			<% for (msg of locals.messages.slice(0, 10)) { %>
				<%- include("./partials/message")%>
			<% } %>
		</div>
		<footer>
			<nav>
				<%  if (locals.offset !== 0) { %>
					<!-- I do not want page=0 when just regular home works. -->
					<%  if (locals.offset === 1) { %>
						<a href="/">&lang; </a>
					<% } else {  %>
						<a href="/?page=<%=(locals. offset -1)%>">&lang; </a>
					<% } %>
				<% } %>
				<%  if (locals.messages.length === 11) { %>
					<a href="/?page=<%=(locals. offset + 1)%>">&rang; </a>
				<% } %>
			</nav>
		</footer>
	</body>
	<script>
		async function deleteMessage(message_id) {
			try {
				fetch(`/delete-message/${message_id}`, {
					method: "DELETE"
				}).then((response) => {
					window.location.reload();
				});
			} catch {
				window.location.href = "/404";
			}
		};
	</script>
</html>
