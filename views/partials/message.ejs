<div class="message">
	<div class="message-header">
		<div class="title">
			<h2><%= msg.title %></h2>
		</div>
		<div class="details">
			<div class="author">
				<p>By: <%= (locals.user && locals.user.member) ? msg.email : "*****" %></p>
			</div>
			<div class="timestamp">
				<p>At: <%= (locals.user && locals.user.member) ? msg.timestamp : "*****" %></p>
			</div>
		</div>
	</div>
	
	<div class="content">
        <%= msg.content %>
        <% if (locals.user && locals.user.admin) { %>
            <!-- DELETE BUTTON GOES HERE -->
			 <button type="button" onClick="deleteMessage(<%= msg.message_id %>)">Delete Message</button>
        <% } %>
    </div>
    
</div>
